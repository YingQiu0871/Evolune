<?xml version="1.0" encoding="utf-8"?>
<!--
  TEST-ONLY manifest. Declares a fixed-height input method used by
  RealAppImeFrameProbeTest so IME inset animations are deterministic instead of
  depending on the emulator's unconfigured Gboard. Merged into the androidTest
  APK only; never part of a production or release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="io.github.yuninggu.evolune.testime.ProbeTestIme"
            android:exported="true"
            android:label="Evolune Probe Test IME"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/probe_test_ime" />
        </service>
    </application>

</manifest>
