diff --git a/app/src/test/java/io/github/yingqiu0871/evolune/data/repository/RoomRepositoryWearBoundaryTest.kt b/app/src/test/java/io/github/yingqiu0871/evolune/data/repository/RoomRepositoryWearBoundaryTest.kt
