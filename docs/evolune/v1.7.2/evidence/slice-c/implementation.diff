+        composeRule.onNodeWithTag("settings-color-scheme-section").performScrollTo()
+        composeRule.onNodeWithTag("palette-tile-monet_amber").performClick()
+        composeRule.waitForIdle()
+        Thread.sleep(400)
+        screenshot("06-monet-amber-selected")
